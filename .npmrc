engine-strict=true
# @launchdarkly/server-sdk-ai-vercel is pre-release and peers
# @launchdarkly/server-sdk-ai@^1, while this repo runs ^2. That range is merely
# stale -- the class it extends (AIProvider) has an identical contract in v2 --
# so the install is forced rather than the core SDK downgraded.
#
# Its `ai` peer range (<=6) is *not* stale: on ai@7 the judge runner dies with
# AI_InvalidPromptError, because it passes the judge rubric as a system message
# and v7 moved that to a separate `instructions` option. `ai` and
# @ai-sdk/anthropic are held at 6.x/3.x until LaunchDarkly ships a v7 adapter.
legacy-peer-deps=true
