# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# LaunchDarkly (client-side ID — exposed to the browser)
PUBLIC_LD_CLIENT_ID=""

# LaunchDarkly (server-side SDK key — SECRET, never PUBLIC_-prefixed). Distinct
# from the client-side ID above: that one only drives browser flag evaluation,
# while this is what lets the server evaluate AI Configs and report generation
# metrics, judge results, and traces. Without it the server SDK never
# initializes, every tracker call no-ops, and an AI Config's Monitoring tab
# stays empty no matter how much the feature is used.
LAUNCHDARKLY_SDK_KEY=""

# Anthropic (server-side only — used by the AI score-scan feature)
ANTHROPIC_API_KEY=""
