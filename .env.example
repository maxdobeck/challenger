# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# LaunchDarkly (client-side ID — exposed to the browser)
PUBLIC_LD_CLIENT_ID=""

# Anthropic (server-side only — powers the /matches score-tracker photo scan).
# For local dev, set this in your untracked .env. For Vercel deploys, set it
# under Project Settings → Environment Variables — never commit a real value.
ANTHROPIC_API_KEY=""
