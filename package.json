{
	"name": "challenger",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:demo": "vite dev --mode demo",
		"build": "vite build",
		"vercel-build": "vite build && node scripts/upload-sourcemaps.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test:e2e": "playwright install && playwright test --grep-invert @traffic",
		"test:e2e:traffic": "playwright install && playwright test --grep @traffic",
		"test:unit": "vitest run",
		"test": "npm run test:unit && npm run test:e2e",
		"db:start": "docker compose up",
		"db:up": "docker compose up -d",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx --env-file-if-exists=.env src/lib/server/db/seed.ts",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"launch": "npm run db:up && npm run db:migrate && npm run db:seed && npm run dev"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.5.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"postgres": "^3.4.9",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.8.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.116.0",
		"@launchdarkly/node-server-sdk": "^9.13.0",
		"@launchdarkly/observability": "^1.1.18",
		"@launchdarkly/server-sdk-ai": "^2.0.0",
		"@launchdarkly/session-replay": "^1.1.18",
		"@upstash/redis": "^1.38.2",
		"fuse.js": "^7.5.0",
		"launchdarkly-js-client-sdk": "^3.9.5"
	}
}
